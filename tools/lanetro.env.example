# Copy the values you need into your shell before starting the bridge.
# Do not commit a real API key.

# Choose one mode. "auto" uses portal push when LAMETRIC_PUSH_URL and
# LAMETRIC_PUSH_TOKEN are present, otherwise it uses direct notification.
export LAMETRIC_MODE="auto"

# Option A: LaMetric Developer Portal / Local Push Indicator App.
# This is the mode to use when the app page gives you a push URL and access token.
export LAMETRIC_PUSH_URL="https://192.168.1.50:4343/api/v1/dev/widget/update/com.lametric.yourpackage/1"
export LAMETRIC_PUSH_TOKEN="paste-x-access-token-here"

# Option B: direct device notification REST API.
export LAMETRIC_HOST="192.168.1.50"
export LAMETRIC_API_KEY="paste-device-api-key-here"

# The LaMetric local API supports http:8080 and https:4343.
export LAMETRIC_PROTOCOL="http"
export LAMETRIC_PORT="8080"

export LANETRO_BRIDGE_HOST="127.0.0.1"
export LANETRO_BRIDGE_PORT="9135"
export YARIG_BASE="http://127.0.0.1:9124/yarig"

# Optional notification tuning.
export LAMETRIC_ICON="a2867"
export LAMETRIC_PRIORITY="info"
export LAMETRIC_SOUND=""
